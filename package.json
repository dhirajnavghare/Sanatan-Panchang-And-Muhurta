  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "TZ=Asia/Kolkata jest --watchAll=false",
    "test:coverage": "TZ=Asia/Kolkata jest --watchAll=false --coverage",
    "test:ci": "TZ=Asia/Kolkata jest --watchAll=false --coverage --ci",
    "test:e2e:router": "TZ=Asia/Kolkata jest __tests__/e2e/appWorkflows.e2e.test.tsx --watchAll=false",
    "test:visual": "TZ=Asia/Kolkata jest __tests__/visual/visualRegression.test.tsx --watchAll=false",
    "test:visual:update": "TZ=Asia/Kolkata UPDATE_VISUAL_BASELINES=1 jest __tests__/visual/visualRegression.test.tsx --watchAll=false",
    "test:visual:png": "node scripts/visual-diff-png.js",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:strict": "eslint . --max-warnings=0",
    "check:quality": "node scripts/check-project-quality.js",
    "build:validate": "rm -rf .tmp-export && npx expo config --type public --json > /dev/null && npx expo export --platform android --output-dir .tmp-export && rm -rf .tmp-export",
    "quality": "npm run typecheck && npm run lint:strict && npm run check:quality && npm run test:ci && npm run build:validate"
  },
  "private": true
}
