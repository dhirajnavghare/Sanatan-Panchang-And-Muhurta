{
  "expo": {
    "name": "Sanatan Panchang & Muhurta",
    "slug": "sanatan-panchang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sanatan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cc.sanatan.app"
    },
    "android": {
      "package": "cc.sanatan.app",
      "adaptiveIcon": {
        "backgroundColor": "#16173d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#16173d"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Sanatan to detect your local coordinates for precise astronomical Sunrise, Sunset, and Tithi timings.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
